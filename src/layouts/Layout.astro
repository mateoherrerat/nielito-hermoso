---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/jetbrains-mono/700.css';

interface Props {
  title?: string;
}

const { title = 'Nielito <3' } = Astro.props;

const directionContract = `<!--
THESIS: Pure typographic ASCII sculpture where the heart is woven solely from the repeated sequence D-A-N-I-E-L-A on a fixed character lattice, refusing fake terminal window chrome, headers, or simulated command prompts.
OWN-WORLD: Deep obsidian ground (#0B0A0E) with three-tier crimson-coral typography (#FFB3C1 contour, #FF758F mid-band, #FF4D6D core) and warm ivory (#FFF0F3) word illumination in JetBrains Mono.
STORY: Daniela opens the page and immediately sees the full tall heart built entirely from her own name, discovering on touch or hover that every seven-character fiber illuminates as D-A-N-I-E-L-A.
FIRST VIEWPORT: Full-viewport centered 57x25 character grid scaled fluidly to 100dvh with zero scroll, zero JavaScript runtime, and 60+ FPS pure CSS performance.
FORM: Grounded candidate 4 (Precision ch-Grid ASCII Lattice), position #4 on ordered list, seed key c6c0bfd8.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
-->`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="DANIELA — Corazón en arte ASCII" />
    <meta name="theme-color" content="#0B0A0E" />
    <title>{title}</title>
  </head>
  <body>
    <Fragment set:html={directionContract} />
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg-obsidian: #08060a;
    --ink-core: #ff2a5f;
    --ink-mid: #ff6090;
    --ink-contour: #ffb3c6;
    --ink-active: #ffffff;
    --font-ascii: 'JetBrains Mono', ui-monospace, 'Cascadia Code', 'Source Code Pro', monospace;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html,
  body {
    height: 100%;
    height: 100dvh;
    overflow: hidden;
    margin: 0;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  html {
    background-color: var(--bg-obsidian);
    color: var(--ink-core);
    font-family: var(--font-ascii);
    color-scheme: dark;
    caret-color: var(--ink-contour);
    -webkit-text-size-adjust: 100%;
  }

  ::selection {
    background-color: var(--ink-core);
    color: var(--bg-obsidian);
  }

  :focus-visible {
    outline: 2px solid var(--ink-contour);
    outline-offset: 4px;
  }

  body {
    display: grid;
    place-items: center;
    background-color: var(--bg-obsidian);
    line-height: 1.5;
  }

  .ascii-viewport {
    position: relative;
    z-index: 10;
    width: 100%;
    height: 100%;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    overflow: hidden;
    padding-top: env(safe-area-inset-top, 0.5rem);
    padding-bottom: env(safe-area-inset-bottom, 0.5rem);
  }

  .ascii-stage {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ascii-stage::before {
    content: '';
    position: absolute;
    width: 95%;
    height: 95%;
    background: radial-gradient(
      ellipse 60% 50% at 50% 48%,
      rgba(255, 42, 95, 0.16) 0%,
      rgba(255, 96, 144, 0.08) 45%,
      transparent 72%
    );
    pointer-events: none;
    z-index: 15;
    filter: blur(24px);
    transform: translateZ(0);
    animation: stage-halo-pulse 3.8s ease-in-out infinite;
  }

  .ascii-heart {
    position: relative;
    z-index: 30;
    font-family: var(--font-ascii);
    /* Mobile-first scaling: optimizes for narrow mobile viewports (up to 92vw) */
    font-size: min(2.18vw, 1.82dvh);
    line-height: 1.14;
    letter-spacing: 0.015em;
    white-space: pre;
    user-select: none;
    -webkit-user-select: none;
    text-align: left;
    font-variant-numeric: tabular-nums;
    margin: 0;
    padding: 0;
    will-change: transform, filter;
    animation: gentle-heart-pulse 3.8s ease-in-out infinite;
    transform-origin: 50% 50%;
  }

  /* Desktop optimization: widescreen viewports with limited height */
  @media (min-width: 769px) {
    .ascii-heart {
      font-size: min(1.45vw, 1.92dvh);
      letter-spacing: 0.03em;
      user-select: text;
      -webkit-user-select: text;
    }
  }

  .ascii-row {
    display: block;
  }

  .ascii-word {
    position: relative;
    z-index: 31;
    display: inline-block;
    vertical-align: top;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    outline: none;
  }

  .ascii-word-default {
    display: inline;
  }

  .ascii-word-hover {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 35;
    width: 100%;
    height: 100%;
    white-space: pre;
    color: var(--ink-active);
    font-weight: 700;
    text-shadow:
      0 0 6px #ffffff,
      0 0 14px rgba(255, 255, 255, 0.95),
      0 0 24px #ff6090,
      0 0 38px #ff2a5f;
  }

  .ascii-word:hover .ascii-word-default,
  .ascii-word:active .ascii-word-default,
  .ascii-word:focus .ascii-word-default {
    visibility: hidden;
  }

  .ascii-word:hover .ascii-word-hover,
  .ascii-word:active .ascii-word-hover,
  .ascii-word:focus .ascii-word-hover {
    display: inline;
  }

  .ascii-cell {
    display: inline;
    cursor: pointer;
  }

  .ascii-contour {
    color: var(--ink-contour);
    font-weight: 700;
    text-shadow:
      0 0 5px rgba(255, 179, 198, 0.85),
      0 0 14px rgba(255, 96, 144, 0.5);
  }

  .ascii-mid {
    color: var(--ink-mid);
    font-weight: 600;
    text-shadow:
      0 0 6px rgba(255, 96, 144, 0.8),
      0 0 16px rgba(255, 42, 95, 0.45);
  }

  .ascii-core {
    color: var(--ink-core);
    font-weight: 500;
    text-shadow:
      0 0 6px rgba(255, 42, 95, 0.75),
      0 0 18px rgba(220, 20, 70, 0.38);
  }

  @keyframes gentle-heart-pulse {
    0%, 100% {
      transform: scale(1);
      filter: drop-shadow(0 0 8px rgba(255, 42, 95, 0.3));
    }
    50% {
      transform: scale(1.02);
      filter: drop-shadow(0 0 16px rgba(255, 96, 144, 0.6)) drop-shadow(0 0 28px rgba(255, 42, 95, 0.3));
    }
  }

  @keyframes stage-halo-pulse {
    0%, 100% {
      opacity: 0.65;
      transform: scale(0.96);
    }
    50% {
      opacity: 1;
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ascii-heart {
      animation: none !important;
    }
    .ascii-word {
      transition: none !important;
    }
  }
</style>
